// Cloudflare Worker config. Workers Builds (GitHub) deploys with this file, so bindings
// live here, not in the dashboard: a dashboard-only binding is dropped on the next push.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libraherbal",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "libraherbal_db",
      "database_id": "9ee5772c-1d11-4747-b6da-6eb60330e002",
      "migrations_dir": "migrations"
    }
  ],
  // Rate limiters (server/middleware/00.ratelimit.ts). Counted per Cloudflare location, period 10 or 60 s.
  // namespace_id only has to be unique within the account.
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_LOGIN_EMAIL", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
  ]
}
