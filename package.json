{
  "name": "libraherbal",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:migrate:local": "wrangler d1 migrations apply libraherbal_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply libraherbal_db --remote",
    "db:seed:local": "wrangler d1 execute libraherbal_db --local --file db/seed.sql",
    "deploy": "nuxt build && wrangler d1 migrations apply libraherbal_db --remote && wrangler deploy"
  },
  "dependencies": {
    "@iconify-json/hugeicons": "^1.2.35",
    "@iconify-json/lucide": "^1.2.138",
    "@iconify-json/simple-icons": "^1.2.98",
    "@nuxt/content": "^3.16.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261001.1": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.147.0"
  }
}
